  </Target>
  <!-- The OCR models live in the project tree, not in the build output: bin\ is
       cleaned and rebuilt, and a payload kept there would go with it. AGShot
       looks for models\ beside the executable and one level above it, so the
       build puts a junction at bin\<platform>\models pointing back at the
       project's own models\. A junction rather than a copy so the weights exist
       once, and a recursive clean of bin\ removes only the link. -->
  <Target Name="LinkOcrModels" BeforeTargets="PrepareForBuild" Condition="Exists('$(SolutionDir)models')">
    <PropertyGroup>
      <OcrModelsLink>$(OutDir)models</OcrModelsLink>
    </PropertyGroup>
    <Exec Command="if not exist &quot;$(OcrModelsLink)\&quot; mklink /J &quot;$(OcrModelsLink)&quot; &quot;$(SolutionDir)models&quot;"
          StandardOutputImportance="low"
          StandardErrorImportance="low" />
  </Target>
